with funnel as(
      select 
 sc.channel                                                                                                     as channel,
 count(distinct sc.session_id)                                                                                  as sessions,
 count(distinct  case when se.event_type='product_view' then sc.session_id end )                               as product_view_sessions,
 count(distinct case when se.event_type='add_to_cart' then sc.session_id  end)                                  as add_to_cart_sessions,
 count(distinct case when se.event_type='begin_checkout' then sc.session_id end)                                as begin_checkout_sessions,
 count(distinct case when se.event_type='purchase' then sc.session_id end)                                      as purchase_sessions                 
from ecom.session_channels  sc
join ecom.session_events    se
on sc.session_id=se.session_id
group by sc.channel
)
select
 *,
 add_to_cart_sessions::numeric *100.00/nullif(product_view_sessions,0)         as view_to_cart_rate,
 begin_checkout_sessions::numeric *100.00/ nullif(add_to_cart_sessions ,0)     as cart_to_checkout_rate,
 purchase_sessions::numeric  *100.00/nullif(begin_checkout_sessions ,0)        as checkout_to_purchase_rate,
 purchase_sessions ::numeric *100.00/nullif(sessions,0)                        as session_to_purchase_rate
 from funnel
