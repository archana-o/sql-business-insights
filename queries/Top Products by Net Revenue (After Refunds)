
with product_revenue as (
        select 
                  p.product_id                                                             as product_id,
	              p.product_name                                                           as product_name,
	              c.category_name                                                          as category,
				  sum(oi.line_total)                                                       as gross_revenue,
				  count(oi.order_id)                                                       as orders_count,
				  sum(oi.qty)                                                              as units_sold
				  
				 
      from ecom.products p 
	  join ecom.categories c on p.category_id=c.category_id
	  join ecom.product_variants pv on p.product_id=pv.product_id
	  join ecom.order_items oi on oi.variant_id=pv.variant_id
	  group by p.product_id,p.product_name,c.category_name
	  ),
product_returns as (
select 
       p.product_id, 
	   pv.variant_id, 
	   count(ri.variant_id)        as   returns_count

from ecom.products p 
join ecom.product_variants pv on p.product_id=pv.product_id
join ecom.return_items ri on pv.variant_id=ri.variant_id
group by p.product_id,pv.variant_id
),
product_refunds as (
  select 
        p.product_id,
	    sum(r.amount) as refund_amount
from ecom.products p join 
ecom.product_variants pv on p.product_id=pv.product_id
join ecom.order_items oi on oi.variant_id=pv.variant_id
join ecom.refunds r on  r.order_id=oi.order_id
group by p.product_id
		)
select
      prev. product_id,
	  prev.product_name,
	  prev.category,
	  prev.gross_revenue,
	  prev.orders_count,
	  prev.units_sold,
	  prtn.returns_count,
	  prtn.returns_count ::numeric / nullif(prev.orders_count,0)                      as  return_rate,
	  pref.refund_amount,
	  gross_revenue-refund_amount                                                      as net_revenue
from 
   product_revenue prev join  product_returns prtn on prev.product_id=prtn.product_id
   JOIN
   product_refunds pref on pref.product_id=prtn.product_id
   order by net_revenue desc
